config_version=5
[application]
config/name="Bubble Regatta"
run/main_scene="res://main.tscn"
[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.macos="metal"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.web=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=0
environment/ssao/quality=1
environment/ssao/half_size=true
[environment]
defaults/default_clear_color=Color(0.1,0.14,0.25,1)

[audio]
driver/output_latency.web=100
